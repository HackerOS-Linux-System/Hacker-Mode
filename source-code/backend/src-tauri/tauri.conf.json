{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hacker Mode",
  "version": "0.2.0",
  "identifier": "com.hackeros.hackermode",
  "build": {
    "beforeDevCommand": "npm --prefix ../../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../../frontend run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "shell",
        "title": "Hacker Mode",
        "width": 1280,
        "height": 800,
        "fullscreen": true,
        "resizable": false,
        "decorations": false,
        "backgroundColor": "#0d0f10",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Game",
    "shortDescription": "Tryb do gier dla HackerOS",
    "longDescription": "Hacker Mode — sesja typu big-picture do uruchamiania i zarządzania grami ze Steam, Epic Games, GOG, Amazon Games i Lutris, działająca jako klient Wayland kompozytora comphwde (--extern-hacker-mode).",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
