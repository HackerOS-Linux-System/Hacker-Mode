{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Domyślne uprawnienia dla powłoki Hacker Mode",
  "windows": ["shell", "storefront-*", "login-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:webview:allow-create-webview-window",
    "core:event:default",
    "shell:allow-open",
    "dialog:default",
    "fs:default",
    "os:default"
  ]
}
