#!/usr/bin/env bash
# Skrypt startowy sesji "Hacker Mode", uruchamiany przez menedżer logowania
# (SDDM/GDM/LightDM) poprzez hacker-mode.desktop albo ręcznie z TTY.
#
# Kompozytor wybiera się w ~/.config/Hacker-Mode/config.json:
#
#     { "compositor": "labwc" }        # domyślnie
#     { "compositor": "comphwde" }     # kompozytor HWDE (wymaga osobnej instalacji)
#
# Kolejność rozstrzygania: zmienna HACKER_MODE_COMPOSITOR -> config.json ->
# stary ~/.config/hacker-mode/config.json -> labwc.
#
# labwc  : `labwc -C <dir> -s <klient>`; klient uruchamia `hacker-mode` i po
#          jego zakończeniu woła `labwc --exit`. (labwc NIE uruchamia opcji
#          -s przez powłokę, dlatego klient to osobny plik wykonywalny.)
#          Działa także z gołego TTY (backend DRM/KMS + libseat).
# comphwde: `comphwde --extern-hacker-mode`, powłoka startowana przez IPC.
#
# Zmienne pomocnicze (głównie do testów):
#   HACKER_MODE_SHELL_BIN  polecenie powłoki (domyślnie: hacker-mode)
#   HACKER_MODE_TEMPLATE_DIR  katalog z szablonami labwc (rc.xml)
#   --print-compositor     wypisz wybrany kompozytor i zakończ

set -euo pipefail

LOG_PREFIX="[hacker-mode-session]"
log() { echo "$LOG_PREFIX $*" >&2; }

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
HM_CONFIG_DIR="$CONFIG_HOME/Hacker-Mode"
HM_CONFIG_FILE="$HM_CONFIG_DIR/config.json"
LEGACY_CONFIG_FILE="$CONFIG_HOME/hacker-mode/config.json"
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hacker-mode"
SHELL_BIN="${HACKER_MODE_SHELL_BIN:-hacker-mode}"

# --- wybór kompozytora ------------------------------------------------------

json_compositor() {
  # Wyciąga wartość klucza "compositor" z pliku JSON ($1) - jq jeśli jest,
  # w przeciwnym razie prosty sed (wystarcza dla płaskiego klucza tekstowego).
  [ -r "$1" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -r '.compositor // empty' "$1" 2>/dev/null || true
  else
    sed -n 's/.*"compositor"[[:space:]]*:[[:space:]]*"\([A-Za-z]*\)".*/\1/p' "$1" | head -n1
  fi
}

resolve_compositor() {
  local value=""
  if [ -n "${HACKER_MODE_COMPOSITOR:-}" ]; then
    value="$HACKER_MODE_COMPOSITOR"
  else
    value="$(json_compositor "$HM_CONFIG_FILE")"
    [ -n "$value" ] || value="$(json_compositor "$LEGACY_CONFIG_FILE")"
  fi
  value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
  case "$value" in
    labwc|comphwde) printf '%s' "$value" ;;
    "") printf 'labwc' ;;
    *) log "Nieznany kompozytor '$value' - używam labwc"; printf 'labwc' ;;
  esac
}

if [ "${1:-}" = "--print-compositor" ]; then
  resolve_compositor; echo
  exit 0
fi

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=HackerMode
export XDG_SESSION_DESKTOP=HackerMode

mkdir -p "$LOG_DIR" "$HM_CONFIG_DIR"
if [ ! -e "$HM_CONFIG_FILE" ] && [ ! -e "$LEGACY_CONFIG_FILE" ]; then
  # Pierwsze uruchomienie: zapisz jawnie domyślny wybór, żeby użytkownik
  # widział, gdzie go zmienić. Backend (serde) uzupełnia resztę ustawień.
  printf '{\n  "compositor": "labwc"\n}\n' > "$HM_CONFIG_FILE"
  chmod 600 "$HM_CONFIG_FILE"
fi

COMPOSITOR="$(resolve_compositor)"
export HACKER_MODE_COMPOSITOR="$COMPOSITOR"
log "Kompozytor: $COMPOSITOR (konfiguracja: $HM_CONFIG_FILE)"

need() {
  command -v "$1" >/dev/null 2>&1 || {
    log "Brak '$1' w PATH. $2" >&2
    exit 1
  }
}

# Powiadomienia i część aplikacji potrzebują magistrali sesyjnej D-Bus.
# Jeśli menedżer logowania jej nie dostarczył, uruchom się ponownie pod
# dbus-run-session (jednokrotnie).
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -z "${HACKER_MODE_DBUS_WRAPPED:-}" ] \
   && command -v dbus-run-session >/dev/null 2>&1; then
  export HACKER_MODE_DBUS_WRAPPED=1
  exec dbus-run-session -- "$0" "$@"
fi

# --- labwc -------------------------------------------------------------------

start_labwc() {
  need labwc "Zainstaluj pakiet 'labwc' (albo ustaw \"compositor\": \"comphwde\" w $HM_CONFIG_FILE)."
  need "$SHELL_BIN" "Uruchom 'sudo make install' (powłoka 'hacker-mode' jest częścią tego repozytorium)."

  local labwc_dir="$HM_CONFIG_DIR/labwc"
  mkdir -p "$labwc_dir"

  # Szablon: jawnie ustawiony > zainstalowany > obok skryptu (repo/dev).
  local template_dir="${HACKER_MODE_TEMPLATE_DIR:-}"
  if [ -z "$template_dir" ]; then
    local here; here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
    for candidate in /usr/share/hacker-mode/labwc "$here/../share/hacker-mode/labwc" "$here/labwc"; do
      if [ -r "$candidate/rc.xml" ]; then template_dir="$candidate"; break; fi
    done
  fi
  [ -r "$template_dir/rc.xml" ] || { log "Nie znaleziono szablonu labwc rc.xml"; exit 1; }

  # Nie nadpisuj rc.xml, który użytkownik świadomie zmienił (bez znacznika).
  if [ ! -e "$labwc_dir/rc.xml" ] || grep -q 'hacker-mode:generated' "$labwc_dir/rc.xml"; then
    cp "$template_dir/rc.xml" "$labwc_dir/rc.xml"
  else
    log "Używam własnego $labwc_dir/rc.xml (brak znacznika hacker-mode:generated)"
  fi

  # Klient startowy labwc: powłoka + zakończenie kompozytora po jej wyjściu.
  local labwc_bin; labwc_bin="$(command -v labwc)"
  local client="$LOG_DIR/labwc-client.sh"
  {
    echo '#!/bin/sh'
    echo 'export HACKER_MODE_COMPOSITOR=labwc'
    printf '%q\n' "$SHELL_BIN"
    echo 'status=$?'
    printf '%q --exit\n' "$labwc_bin"
    echo 'exit $status'
  } > "$client"
  chmod 700 "$client"

  log "Start labwc (log: $LOG_DIR/compositor.log)"
  exec "$labwc_bin" -C "$labwc_dir" -s "$client" >"$LOG_DIR/compositor.log" 2>&1
}

# --- comphwde ----------------------------------------------------------------

start_comphwde() {
  # Ta sama logika co `sde_ipc::runtime_dir()` po stronie comphwde/ipc crate.
  local ipc_sock
  if [ -n "${HACKER_MODE_IPC_SOCKET:-}" ]; then
    ipc_sock="$HACKER_MODE_IPC_SOCKET"
  elif [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    ipc_sock="${XDG_RUNTIME_DIR}/sde/comphwde-hacker-mode.sock"
  else
    ipc_sock="/tmp/sde-$(id -u)/comphwde-hacker-mode.sock"
  fi

  need comphwde "Zainstaluj comphwde (projekt HWDE) albo usuń \"compositor\": \"comphwde\" z $HM_CONFIG_FILE (domyślnie labwc)."
  need hacker-mode-ipcctl "Uruchom 'sudo make install'."
  need "$SHELL_BIN" "Uruchom 'sudo make install'."

  comphwde --extern-hacker-mode >"$LOG_DIR/compositor.log" 2>&1 &
  local pid=$!
  trap 'kill "$pid" 2>/dev/null || true' EXIT INT TERM

  local ready=0
  for _ in $(seq 1 100); do
    if [ -S "$ipc_sock" ]; then ready=1; break; fi
    if ! kill -0 "$pid" 2>/dev/null; then
      log "comphwde zakończył się przedwcześnie - sprawdź $LOG_DIR/compositor.log"
      exit 1
    fi
    sleep 0.1
  done
  if [ "$ready" -ne 1 ]; then
    log "comphwde nie wystawił gniazda IPC ($ipc_sock) w ciągu 10s - sprawdź $LOG_DIR/compositor.log"
    exit 1
  fi

  # `hacker-mode-ipcctl launch` tylko wysyła żądanie; powłoka startuje jako
  # klient Wayland comphwde (z poprawnym WAYLAND_DISPLAY).
  if ! hacker-mode-ipcctl launch "$SHELL_BIN"; then
    log "Nie udało się poprosić comphwde o uruchomienie powłoki - sprawdź $LOG_DIR/compositor.log"
    exit 1
  fi

  wait "$pid"
}

case "$COMPOSITOR" in
  labwc) start_labwc ;;
  comphwde) start_comphwde ;;
esac
