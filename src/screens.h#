fn roblox_client_card(a: state::App, v: ui::View) is
    let installed: bool = roblox::sober_installed()
    ui::open(v, "container", "", ui::a("class", "card") + ui::a("pad", "20") + ui::a("w", "px:340"))
    ui::open(v, "column", "", ui::a("spacing", "10"))
    ui::leaf(v, "text", t(a, "Klient Roblox (Sober)"), ui::a("size", "18") + ui::a("bold", "1"))
    if installed is
        ui::leaf(v, "text", if roblox::running() then "● działa" else "● zainstalowany", ui::a("class", "success"))
        ui::leaf(v, "toggler", "GameMode", ui::a("on", if roblox::sober_flag("enable_gamemode", false) then "1" else "0") + ui::a("toggle", "rb:flag:enable_gamemode"))
        ui::leaf(v, "toggler", "OpenGL (zamiast Vulkan)", ui::a("on", if roblox::sober_flag("use_opengl", false) then "1" else "0") + ui::a("toggle", "rb:flag:use_opengl"))
    else is
        ui::leaf(v, "text", "Sober nie jest zainstalowany. Roblox nie ma oficjalnego klienta na Linuksa — Hacker Mode korzysta z nieoficjalnego Sobera (flatpak).", ui::a("class", "caption") + ui::a("fillw", "1"))
        ui::btn(v, t(a, "Zainstaluj Sober"), "rb:install", "primary", "download")
    end
    ui::close(v)
    ui::close(v)
end

fn roblox_add_card(a: state::App, v: ui::View) is
    ui::open(v, "container", "", ui::a("class", "card") + ui::a("pad", "20") + ui::a("w", "px:340"))
    ui::open(v, "column", "", ui::a("spacing", "10"))
    ui::leaf(v, "text", t(a, "Dodaj po linku lub numerze miejsca"), ui::a("bold", "1"))
    ui::leaf(v, "text_input", "roblox.com/games/…", ui::a("val", a.rb_link) + ui::a("input", "rb:link") + ui::a("submit", "rb:add") + ui::a("id", "rb-link"))
    ui::btn(v, t(a, "Dodaj"), "rb:add", "ghost", "plus")
    ui::gap(v, 4)
    ui::leaf(v, "text", t(a, "Import ulubionych (nazwa użytkownika)"), ui::a("bold", "1"))
    ui::leaf(v, "text_input", "username", ui::a("val", a.rb_user) + ui::a("input", "rb:user") + ui::a("submit", "rb:import") + ui::a("id", "rb-user"))
    ui::btn(v, t(a, "Importuj"), "rb:import", "ghost", "download")
    ui::close(v)
    ui::close(v)
end

fn roblox_detail(a: state::App, v: ui::View) is
    let d: roblox::Info = a.rb_info
    let pinned: bool = roblox::is_pinned(d.place)
    let job: jobs::Job = state::job_for(a, model::key_of("roblox", d.place))
    ui::open(v, "container", "", ui::a("class", "card") + ui::a("pad", "22") + ui::a("w", "px:360") + ui::a("fillh", "1"))
    ui::open(v, "scroll", "", ui::a("fillh", "1"))
    ui::open(v, "column", "", ui::a("spacing", "12") + ui::a("fillw", "1"))
    ui::open(v, "row", "", ui::a("fillw", "1"))
    ui::leaf(v, "badge", "Roblox", ui::a("fg", model::accent("roblox")))
    ui::grow(v)
    ui::btn(v, "", "rb:sel:", "ghost icon", "x")
    ui::close(v)
    if d.icon != "" is ui::leaf(v, "image", d.icon, ui::a("wh", "300,300") + ui::a("fit", "1") + ui::a("radius", "16") + ui::a("clip", "1")) end
    ui::leaf(v, "text", d.name, ui::a("size", "24") + ui::a("bold", "1"))
    if d.creator != "" is ui::leaf(v, "text", t(a, "Twórca") + ": " + d.creator, ui::a("class", "muted")) end
    ui::leaf(v, "text", t(a, "Graczy teraz") + ": " + to_string(d.playing) + "   " + t(a, "Odwiedziny") + ": " + to_string(d.visits), ui::a("class", "muted"))
    if d.likes >= 0 is ui::leaf(v, "text", t(a, "Polubienia") + ": " + to_string(d.likes) + "%", ui::a("class", "muted")) end
    if d.desc != "" is ui::leaf(v, "text", util::clip(d.desc, 360), ui::a("class", "caption") + ui::a("fillw", "1")) end
    if job.id != "" is
        ui::btn(v, t(a, "Zatrzymaj"), "job:stop:" + job.id, "danger", "x")
    else is
        ui::btn(v, t(a, "Graj"), "rb:play:" + d.place, "primary", "play")
    end
    if pinned is
        ui::btn(v, t(a, "Usuń z biblioteki"), "rb:unpin:" + d.place, "ghost", "trash")
    else is
        ui::btn(v, t(a, "Dodaj do biblioteki"), "rb:pin:" + d.place, "ghost", "plus")
    end
    ui::close(v)
    ui::close(v)
    ui::close(v)
end

fn roblox_tab(a: state::App, v: ui::View) is
    ui::open(v, "row", "", ui::a("fillw", "1") + ui::a("fillh", "1") + ui::a("spacing", "0"))
    ;; lewa kolumna
    ui::open(v, "container", "", ui::a("pad", "24"))
    ui::open(v, "scroll", "", ui::a("fillh", "1"))
    ui::open(v, "column", "", ui::a("spacing", "16"))
    roblox_client_card(a, v)
    roblox_add_card(a, v)
    ui::close(v)
    ui::close(v)
    ui::close(v)
    ;; środek
    ui::open(v, "container", "", ui::a("padxy", "8,24") + ui::a("fillw", "1") + ui::a("fillh", "1"))
    ui::open(v, "column", "", ui::a("spacing", "16") + ui::a("fillw", "1") + ui::a("fillh", "1"))
    ui::open(v, "row", "", ui::a("spacing", "10") + ui::a("ay", "1") + ui::a("fillw", "1"))
    ui::chip(v, t(a, "Moje doświadczenia"), "rb:mode:mine", a.rb_mode == "mine")
    ui::chip(v, t(a, "Szukaj w Roblox"), "rb:mode:search", a.rb_mode == "search")
    ui::close(v)
    if a.rb_mode == "search" is
        ui::open(v, "row", "", ui::a("spacing", "10") + ui::a("fillw", "1"))
        ui::leaf(v, "text_input", "obby, tycoon, horror…", ui::a("val", a.rb_query) + ui::a("input", "rb:q") + ui::a("submit", "rb:search") + ui::a("id", "rb-q") + ui::a("fillw", "1"))
        ui::btn(v, t(a, "Szukaj"), "rb:search", "primary", "search")
        ui::close(v)
        ui::open(v, "row", "", ui::a("spacing", "8"))
        ui::chip(v, "obby", "rb:chip:obby", false)
        ui::chip(v, "tycoon", "rb:chip:tycoon", false)
        ui::chip(v, "simulator", "rb:chip:simulator", false)
        ui::chip(v, "horror", "rb:chip:horror", false)
        ui::chip(v, "roleplay", "rb:chip:roleplay", false)
        ui::close(v)
    end
    if a.busy != "" is ui::leaf(v, "text", a.busy, ui::a("class", "muted") + ui::a("size", "18")) end
    ui::open(v, "scroll", "", ui::a("fillw", "1") + ui::a("fillh", "1"))
    ui::open(v, "column", "", ui::a("spacing", "18"))
    let per_row: int = if a.rb_sel != "" then 3 else 5
    if a.rb_mode == "mine" is
        let mine: [model::Game] = roblox_games(a)
        if array_len(mine) == 0 && a.busy == "" is ui::leaf(v, "text", t(a, "Brak gier"), ui::a("class", "muted")) end
        let mut r: int = 0
        while r * per_row < array_len(mine) is
            ui::open(v, "row", "", ui::a("spacing", "18"))
            let mut c: int = 0
            while c < per_row && r * per_row + c < array_len(mine) is
                let g: model::Game = mine[r * per_row + c]
                tile(v, "rb:sel:" + g.id, g.cover, g.title, "", 180, 180, "roblox", false)
                c += 1
            end
            ui::close(v)
            r += 1
        end
    else is
        let mut r2: int = 0
        while r2 * per_row < array_len(a.rb_results) is
            ui::open(v, "row", "", ui::a("spacing", "18"))
            let mut c2: int = 0
            while c2 < per_row && r2 * per_row + c2 < array_len(a.rb_results) is
                let d: roblox::Info = a.rb_results[r2 * per_row + c2]
                tile(v, "rb:sel:" + d.place, d.icon, d.name, to_string(d.playing) + " online", 180, 180, "roblox", false)
                c2 += 1
            end
            ui::close(v)
            r2 += 1
        end
    end
    ui::close(v)
    ui::close(v)
    ui::close(v)
    ui::close(v)
    if a.rb_sel != "" is roblox_detail(a, v) end
    ui::close(v)
end

fn roblox_games(a: state::App) -> [model::Game] is
    let mut out: [model::Game] = []
    let mut i: int = 0
    while i < array_len(a.games) is
        if a.games[i].platform == "roblox" is out = array_push(out, a.games[i]) end
        i += 1
    end
    return out
end

