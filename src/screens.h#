fn section(v: ui::View, title: string) is
    ui::open(v, "container", "", ui::a("class", "card") + ui::a("pad", "22") + ui::a("maxw", "760") + ui::a("fillw", "1"))
    ui::open(v, "column", "", ui::a("spacing", "12") + ui::a("fillw", "1"))
    ui::leaf(v, "text", title, ui::a("size", "18") + ui::a("bold", "1"))
end

fn section_end(v: ui::View) is
    ui::close(v)
    ui::close(v)
end

fn settings_tab(a: state::App, v: ui::View) is
    ui::open(v, "container", "", ui::a("pad", "24") + ui::a("fillw", "1") + ui::a("fillh", "1"))
    ui::open(v, "scroll", "", ui::a("fillw", "1") + ui::a("fillh", "1"))
    ui::open(v, "column", "", ui::a("spacing", "18") + ui::a("fillw", "1"))

    section(v, t(a, "Język"))
    ui::open(v, "row", "", ui::a("spacing", "8"))
    ui::chip(v, "Polski", "set:lang:pl", a.lang == "pl")
    ui::chip(v, "English", "set:lang:en", a.lang == "en")
    ui::close(v)
    section_end(v)

    section(v, t(a, "Motyw"))
    ui::open(v, "row", "", ui::a("spacing", "8"))
    let themes: [string] = ["dark", "light", "nord", "dracula", "tokyo", "glass"]
    let mut i: int = 0
    while i < array_len(themes) is
        ui::chip(v, themes[i], "set:theme:" + themes[i], settings::theme(a.s) == themes[i])
        i += 1
    end
    ui::close(v)
    section_end(v)

    section(v, t(a, "Narzędzia gamingowe"))
    ui::leaf(v, "toggler", t(a, "Tryb wrapper (ukryj powłokę podczas gry)"), ui::a("on", if settings::wrapper_mode(a.s) then "1" else "0") + ui::a("toggle", "set:wrapper"))
    ui::leaf(v, "toggler", "MangoHud", ui::a("on", if settings::get_bool(a.s, "gaming_tools.mangohud", true) then "1" else "0") + ui::a("toggle", "set:tool:mangohud"))
    ui::leaf(v, "toggler", "gamescope", ui::a("on", if settings::get_bool(a.s, "gaming_tools.gamescope", false) then "1" else "0") + ui::a("toggle", "set:tool:gamescope"))
    ui::leaf(v, "toggler", "vkBasalt", ui::a("on", if settings::get_bool(a.s, "gaming_tools.vkbasalt", false) then "1" else "0") + ui::a("toggle", "set:tool:vkbasalt"))
    section_end(v)

    section(v, t(a, "Platformy"))
    let plats: [string] = model::all_platforms()
    let mut p: int = 0
    while p < array_len(plats) is
        let ok: bool = stores::is_available(a.s, plats[p])
        ui::leaf(v, "toggler", model::label(plats[p]) + (if ok then "" else "  (niedostępna)"), ui::a("on", if settings::platform_enabled(a.s, plats[p]) then "1" else "0") + ui::a("toggle", "set:plat:" + plats[p]))
        if stores::supports_login(plats[p]) && ok && !stores::is_logged_in(a.s, plats[p]) is
            ui::btn(v, t(a, "Zaloguj") + " — " + model::label(plats[p]), "login:" + plats[p], "ghost", "lock-open")
        end
        p += 1
    end
    section_end(v)

    section(v, "Steam / SteamGridDB")
    ui::leaf(v, "text", t(a, "Klucz Steam API"), ui::a("class", "muted"))
    ui::leaf(v, "text_input", "XXXXXXXX…", ui::a("val", a.input_steam) + ui::a("input", "in:steamkey") + ui::a("secret", "1"))
    ui::leaf(v, "text", t(a, "SteamID64"), ui::a("class", "muted"))
    ui::leaf(v, "text_input", "7656119…", ui::a("val", a.input_steamid) + ui::a("input", "in:steamid"))
    ui::leaf(v, "text", t(a, "Klucz SteamGridDB"), ui::a("class", "muted"))
    ui::leaf(v, "text_input", "…", ui::a("val", a.input_sgdb) + ui::a("input", "in:sgdb") + ui::a("secret", "1"))
    ui::btn(v, t(a, "Zapisz"), "set:keys", "primary", "check")
    section_end(v)

    section(v, t(a, "Dźwięk i jasność"))
    ui::open(v, "row", "", ui::a("spacing", "8"))
    ui::btn(v, "Vol −", "sys:vol-", "ghost", "volume-x")
    ui::btn(v, "Vol +", "sys:vol+", "ghost", "volume-2")
    ui::btn(v, "Mute", "sys:mute", "ghost", "")
    ui::btn(v, "Jasność −", "sys:bri-", "ghost", "sun")
    ui::btn(v, "Jasność +", "sys:bri+", "ghost", "sun")
    ui::btn(v, "Wi-Fi", "sys:wifi", "ghost", "wifi")
    ui::close(v)
    section_end(v)

    section(v, t(a, "Zasilanie"))
    ui::open(v, "row", "", ui::a("spacing", "8"))
    ui::btn(v, "Power saver", "sys:profile:power_saving", "ghost", "battery")
    ui::btn(v, "Balanced", "sys:profile:balanced", "ghost", "battery")
    ui::btn(v, "Performance", "sys:profile:performance", "ghost", "cpu")
    ui::close(v)
    ui::open(v, "row", "", ui::a("spacing", "8"))
    ui::btn(v, t(a, "Uśpij"), "power:sleep", "ghost", "moon")
    ui::btn(v, t(a, "Restart"), "power:restart", "ghost", "refresh-cw")
    ui::btn(v, t(a, "Wyłącz"), "power:shutdown", "danger", "power")
    ui::close(v)
    if a.dev is ui::leaf(v, "text", "Tryb dev: akcje zasilania są tylko symulowane.", ui::a("class", "caption")) end
    section_end(v)

    ui::close(v)
    ui::close(v)
    ui::close(v)
end

;; ── Diagnostyka ──────────────────────────────────────────────────────────────

fn doctor_tab(a: state::App, v: ui::View) is
    ui::open(v, "container", "", ui::a("pad", "24") + ui::a("fillw", "1") + ui::a("fillh", "1"))
    ui::open(v, "column", "", ui::a("spacing", "14") + ui::a("fillw", "1") + ui::a("fillh", "1"))
    ui::btn(v, t(a, "Uruchom diagnostykę"), "doctor:run", "primary", "refresh-cw")
    ui::open(v, "scroll", "", ui::a("fillw", "1") + ui::a("fillh", "1"))
    ui::open(v, "column", "", ui::a("spacing", "6") + ui::a("fillw", "1"))
    let mut group: string = ""
    let mut i: int = 0
    while i < array_len(a.doctor) is
        let p: [string] = string_split(a.doctor[i], "|")
        if array_len(p) >= 4 is
            if p[3] != group is
                group = p[3]
                ui::gap(v, 6)
                ui::leaf(v, "text", group, ui::a("size", "18") + ui::a("bold", "1"))
            end
            ui::open(v, "row", "", ui::a("spacing", "10"))
            ui::leaf(v, "icon", if p[1] == "1" then "circle-check" else "triangle-alert", ui::a("fg", if p[1] == "1" then "#9ece6a" else "#f7768e"))
            ui::leaf(v, "text", p[0], ui::a("bold", "1"))
            if p[1] != "1" is ui::leaf(v, "text", "→ " + p[2], ui::a("class", "caption")) end
            ui::close(v)
        end
        i += 1
    end
    ui::close(v)
    ui::close(v)
    ui::close(v)
    ui::close(v)
end

;; ── korzeń ───────────────────────────────────────────────────────────────────

pub fn render(a: state::App) -> string is
    let v: ui::View = ui::view()
    ui::open(v, "stack", "", ui::a("filla", "1"))
    ui::open(v, "column", "", ui::a("filla", "1") + ui::a("spacing", "0"))
    topbar(a, v)
    ui::open(v, "container", "", ui::a("fillw", "1") + ui::a("fillh", "1"))
    if a.tab == "library" is library(a, v) end
    if a.tab == "roblox" is roblox_tab(a, v) end
    if a.tab == "settings" is settings_tab(a, v) end
    if a.tab == "doctor" is doctor_tab(a, v) end
    ui::close(v)
    jobs_bar(a, v)
    ui::close(v)
    ;; warstwa nakładek
    ui::open(v, "container", "", ui::a("filla", "1") + ui::a("ax", "1") + ui::a("ay", "2") + ui::a("pad", "30"))
    toast(a, v)
    ui::close(v)
    confirm_modal(a, v)
    ui::close(v)
    return v.out
end
