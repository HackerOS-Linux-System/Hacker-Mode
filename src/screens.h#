fn tab_button(a: state::App, v: ui::View, name: string, label: string, icon: string) is
    ui::btn(v, t(a, label), "tab:" + name, if a.tab == name then "tab tab-on" else "tab", icon)
end

fn topbar(a: state::App, v: ui::View) is
    ui::open(v, "container", "", ui::a("id", "topbar") + ui::a("class", "glass") + ui::a("padxy", "26,14") + ui::a("fillw", "1"))
    ui::open(v, "row", "", ui::a("spacing", "10") + ui::a("ay", "1") + ui::a("fillw", "1"))
    ui::leaf(v, "text", "HACKER MODE", ui::a("size", "22") + ui::a("bold", "1") + ui::a("lsp", "2"))
    ui::gap(v, 18)
    tab_button(a, v, "library", "Biblioteka", "layout-grid")
    tab_button(a, v, "roblox", "Roblox", "globe")
    tab_button(a, v, "settings", "Ustawienia", "settings")
    tab_button(a, v, "doctor", "Diagnostyka", "info")
    ui::grow(v)
    if a.volume >= 0 is ui::leaf(v, "text", "vol " + to_string(a.volume) + "%", ui::a("class", "muted")) end
    if a.battery >= 0 is ui::leaf(v, "text", "bat " + to_string(a.battery) + "%", ui::a("class", "muted")) end
    ui::btn(v, "", "refresh", "ghost icon", "refresh-cw")
    ui::btn(v, "", "exit", "ghost icon", "log-out")
    ui::close(v)
    ui::close(v)
end

;; kafelek z okładką (przycisk, więc działa z klawiaturą i padem)
fn tile(v: ui::View, id: string, cover: string, title: string, sub: string, w: int, h: int, platform: string, dim: bool) is
    ui::open(v, "button_with", "", ui::a("press", id) + ui::a("class", "tile") + ui::a("focusable", "1"))
    ui::open(v, "column", "", ui::a("spacing", "0") + ui::a("clip", "1") + ui::a("radius", "18"))
    if cover != "" is
        ui::leaf(v, "image", cover, ui::a("wh", to_string(w) + "," + to_string(h)) + ui::a("fit", "1") + (if dim then ui::a("opacity", "0.45") else ""))
    else is
        ui::open(v, "container", "", ui::a("wh", to_string(w) + "," + to_string(h)) + ui::a("grad", "#1f2335,#2f3549,90") + ui::a("center", "1"))
        ui::leaf(v, "icon", model::icon(platform), ui::a("size", "44") + ui::a("fg", model::accent(platform)))
        ui::close(v)
    end
    ui::open(v, "container", "", ui::a("pad", "10") + ui::a("w", "px:" + to_string(w)))
    ui::open(v, "column", "", ui::a("spacing", "3"))
    ui::leaf(v, "text", util::clip(title, 26), ui::a("size", "14") + ui::a("bold", "1") + ui::a("nowrap", "1"))
    if sub != "" is ui::leaf(v, "text", sub, ui::a("class", "caption")) end
    ui::close(v)
    ui::close(v)
    ui::close(v)
    ui::close(v)
end

fn jobs_bar(a: state::App, v: ui::View) is
    let mut shown: int = 0
    let mut i: int = 0
    while i < array_len(a.jobs) is
        let j: jobs::Job = a.jobs[i]
        if !j.done && shown < 3 is
            shown += 1
            ui::open(v, "container", "", ui::a("class", "panel") + ui::a("padxy", "24,10") + ui::a("fillw", "1"))
            ui::open(v, "row", "", ui::a("spacing", "14") + ui::a("ay", "1") + ui::a("fillw", "1"))
            let verb: string = if j.kind == "game" then "Gra" else (if j.kind == "install" then "Instalacja" else (if j.kind == "uninstall" then "Usuwanie" else "Klient"))
            ui::leaf(v, "text", verb + ": " + j.title, ui::a("bold", "1"))
            if j.percent >= 0 is
                ui::leaf(v, "progress", "", ui::a("lo", "0") + ui::a("hi", "100") + ui::a("v", to_string(j.percent)) + ui::a("w", "px:260"))
                ui::leaf(v, "text", to_string(j.percent) + "%", ui::a("class", "muted"))
            end
            if j.last_line != "" is ui::leaf(v, "text", util::clip(j.last_line, 70), ui::a("class", "caption")) end
            ui::grow(v)
            if j.kind == "game" is ui::leaf(v, "text", util::fmt_minutes(jobs::minutes_ran(j)), ui::a("class", "muted")) end
            ui::btn(v, t(a, "Zatrzymaj"), "job:stop:" + j.id, "danger", "x")
            ui::close(v)
            ui::close(v)
        end
        i += 1
    end
end

fn toast(a: state::App, v: ui::View) is
    if a.toast == "" || now_unix() > a.toast_until is return end
    ui::open(v, "container", "", ui::a("class", "toast card") + ui::a("padxy", "22,14") + ui::a("centerx", "1"))
    ui::leaf(v, "text", a.toast, ui::a("bold", "1"))
    ui::close(v)
end

;; potwierdzenie czynności destrukcyjnych
fn confirm_modal(a: state::App, v: ui::View) is
    if a.confirm == "" is return end
    let kind: string = util::before(a.confirm, ":")
    let arg: string = util::after(a.confirm, ":")
    let mut question: string = ""
    if kind == "uninstall" is question = "Odinstalować „" + state::find_game(a, arg).title + "”?" end
    if kind == "unpin" is question = "Usunąć to doświadczenie z biblioteki Roblox?" end
    if kind == "power" is question = "Na pewno: " + arg + "?" end
    if kind == "exit" is question = "Wyjść z powłoki Hacker Mode?" end
    ui::open(v, "modal", "", ui::a("open", "1") + ui::a("dismiss", "confirm:no"))
    ui::open(v, "container", "", ui::a("class", "card") + ui::a("pad", "28") + ui::a("maxw", "460"))
    ui::open(v, "column", "", ui::a("spacing", "18"))
    ui::leaf(v, "text", question, ui::a("size", "20") + ui::a("bold", "1"))
    ui::open(v, "row", "", ui::a("spacing", "12"))
    ui::btn(v, t(a, "Anuluj"), "confirm:no", "ghost", "x")
    ui::btn(v, t(a, "Tak, usuń"), "confirm:yes", "danger", "check")
    ui::close(v)
    ui::close(v)
    ui::close(v)
    ui::close(v)
end

;; ── Biblioteka ───────────────────────────────────────────────────────────────

fn matches(a: state::App, g: model::Game) -> bool is
    if a.filter != "" && g.platform != a.filter is return false end
    if a.query != "" && !string_contains(string_lower(g.title), string_lower(a.query)) is return false end
    return true
end

fn detail_panel(a: state::App, v: ui::View, g: model::Game) is
    let key: string = model::key(g)
    let job: jobs::Job = state::job_for(a, key)
    ui::open(v, "container", "", ui::a("class", "card") + ui::a("pad", "22") + ui::a("w", "px:360") + ui::a("fillh", "1"))
    ui::open(v, "scroll", "", ui::a("fillh", "1"))
    ui::open(v, "column", "", ui::a("spacing", "14") + ui::a("fillw", "1"))
    ui::open(v, "row", "", ui::a("fillw", "1"))
    ui::leaf(v, "badge", model::label(g.platform), ui::a("fg", model::accent(g.platform)))
    ui::grow(v)
    ui::btn(v, "", "sel:", "ghost icon", "x")
    ui::close(v)
    if g.cover != "" is
        ui::leaf(v, "image", g.cover, ui::a("wh", "300,420") + ui::a("fit", "1") + ui::a("radius", "16") + ui::a("clip", "1"))
    end
    ui::leaf(v, "text", g.title, ui::a("size", "24") + ui::a("bold", "1"))
    ui::leaf(v, "text", if g.installed then t(a, "Zainstalowana") else t(a, "Nie zainstalowana"), ui::a("class", if g.installed then "success" else "muted"))
    if g.playtime >= 0 is
        ui::leaf(v, "text", t(a, "Czas gry") + ": " + util::fmt_minutes(g.playtime), ui::a("class", "muted"))
    end
    if g.path != "" is ui::leaf(v, "text", util::clip(g.path, 44), ui::a("class", "caption")) end
    if job.id != "" is
        if job.percent >= 0 is
            ui::leaf(v, "progress", "", ui::a("lo", "0") + ui::a("hi", "100") + ui::a("v", to_string(job.percent)) + ui::a("fillw", "1"))
        end
        ui::btn(v, t(a, "Zatrzymaj"), "job:stop:" + job.id, "danger", "x")
    else is
        if g.installed is
            ui::btn(v, t(a, "Graj"), "play:" + key, "primary", "play")
        else is
            ui::btn(v, t(a, "Zainstaluj"), "install:" + key, "primary", "download")
        end
        if g.installed && g.platform != "lutris" is
            ui::btn(v, if g.platform == "roblox" then t(a, "Usuń z biblioteki") else t(a, "Odinstaluj"), "uninstall:" + key, "ghost", "trash")
        end
        if settings::save_path_of(a.s, key) != "" is
            ui::btn(v, t(a, "Kopia zapisów"), "backup:" + key, "ghost", "upload")
            ui::btn(v, t(a, "Przywróć zapisy"), "restore:" + key, "ghost", "download")
        end
    end
    let tags: [string] = settings::tags_of(a.s, key)
    if array_len(tags) > 0 is
        ui::leaf(v, "text", "# " + util::join(tags, "  # "), ui::a("class", "caption"))
    end
    let sess: [string] = playtime::recent_sessions(key, 3)
    if array_len(sess) > 0 is
        ui::leaf(v, "text", t(a, "Ostatnio grane"), ui::a("class", "muted"))
        let mut i: int = 0
        while i < array_len(sess) is
            let p: [string] = string_split(sess[i], "|")
            ui::leaf(v, "text", util::fmt_date(str_to_int(p[0])) + "  ·  " + util::fmt_minutes(str_to_int(p[1])), ui::a("class", "caption"))
            i += 1
        end
    end
    ui::close(v)
    ui::close(v)
    ui::close(v)
end

fn library(a: state::App, v: ui::View) is
    ui::open(v, "row", "", ui::a("fillw", "1") + ui::a("fillh", "1") + ui::a("spacing", "0"))
    ui::open(v, "container", "", ui::a("pad", "24") + ui::a("fillw", "1") + ui::a("fillh", "1"))
    ui::open(v, "column", "", ui::a("spacing", "16") + ui::a("fillw", "1") + ui::a("fillh", "1"))

    ;; filtry platform + wyszukiwarka
    ui::open(v, "row", "", ui::a("spacing", "8") + ui::a("ay", "1") + ui::a("fillw", "1"))
    ui::chip(v, t(a, "Wszystkie"), "filter:", a.filter == "")
    let plats: [string] = model::all_platforms()
    let mut p: int = 0
    while p < array_len(plats) is
        if settings::platform_enabled(a.s, plats[p]) && stores::is_available(a.s, plats[p]) is
            ui::chip(v, model::label(plats[p]), "filter:" + plats[p], a.filter == plats[p])
        end
        p += 1
    end
    ui::close(v)
    ui::leaf(v, "text_input", t(a, "Szukaj gier…"), ui::a("val", a.query) + ui::a("input", "search") + ui::a("id", "search") + ui::a("fillw", "1"))

    if a.busy != "" is
        ui::leaf(v, "text", a.busy, ui::a("class", "muted") + ui::a("size", "18"))
    elsif !a.loaded is
        ui::leaf(v, "text", t(a, "Wczytuję bibliotekę…"), ui::a("class", "muted") + ui::a("size", "18"))
    else is
        ;; policz dopasowania
        let mut hits: [model::Game] = []
        let mut i: int = 0
        while i < array_len(a.games) is
            if matches(a, a.games[i]) is hits = array_push(hits, a.games[i]) end
            i += 1
        end
        if array_len(hits) == 0 is
            ui::leaf(v, "text", t(a, "Brak gier"), ui::a("class", "muted") + ui::a("size", "18"))
        end
        let limit: int = (a.page + 1) * 40
        let shown: int = if array_len(hits) < limit then array_len(hits) else limit
        let per_row: int = if a.selected != "" then 4 else 6
        ui::open(v, "scroll", "", ui::a("fillw", "1") + ui::a("fillh", "1"))
        ui::open(v, "column", "", ui::a("spacing", "18") + ui::a("fillw", "1"))
        let mut r: int = 0
        while r * per_row < shown is
            ui::open(v, "row", "", ui::a("spacing", "18"))
            let mut c: int = 0
            while c < per_row && r * per_row + c < shown is
                let g: model::Game = hits[r * per_row + c]
                let sub: string = if g.playtime > 0 then util::fmt_minutes(g.playtime) else model::label(g.platform)
                tile(v, "sel:" + model::key(g), g.cover, g.title, sub, 170, 240, g.platform, !g.installed)
                c += 1
            end
            ui::close(v)
            r += 1
        end
        if shown < array_len(hits) is ui::btn(v, t(a, "Pokaż więcej"), "more", "ghost", "chevron-down") end
        ui::close(v)
        ui::close(v)
    end
    ui::close(v)
    ui::close(v)
    if a.selected != "" is
        let g2: model::Game = state::find_game(a, a.selected)
        if g2.id != "" is detail_panel(a, v, g2) end
    end
    ui::close(v)
end

