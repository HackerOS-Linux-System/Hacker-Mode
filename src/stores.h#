;; Po przechwyceniu kodu autoryzacyjnego. Zwraca "" przy sukcesie, inaczej komunikat błędu.
pub fn login_submit(platform: string, code: string) -> string is
    let c: string = util::sq(code)
    if platform == "epic" is
        if util::rc("legendary auth --code " + c) == 0 is return "" end
        return "legendary auth nie powiodło się"
    end
    if platform == "gog" is
        util::mkdirp(gog_cfg())
        if util::rc("gogdl --auth-config-path " + util::sq(gog_cfg()) + " auth --code " + c) == 0 is return "" end
        return "gogdl auth nie powiodło się"
    end
    return "ta platforma nie używa kodu"
end

;; Pełna biblioteka wybranych platform (zainstalowane + posiadane-niezainstalowane), z lokalnym czasem gry.
pub fn list_all(s: settings::Settings) -> [model::Game] is
    let mut all: [model::Game] = []
    let mut p: int = 0
    let plats: [string] = model::all_platforms()
    while p < array_len(plats) is
        let slug: string = plats[p]
        if settings::platform_enabled(s, slug) && is_available(s, slug) is
            let mut part: [model::Game] = []
            if slug == "steam" is
                part = steam_list(s)
                let owned: [model::Game] = steam_owned(s)
                let mut o: int = 0
                while o < array_len(owned) is
                    let mut have: bool = false
                    let mut q: int = 0
                    while q < array_len(part) is
                        if part[q].id == owned[o].id is
                            have = true
                            if part[q].playtime < 0 is part[q].playtime = owned[o].playtime end
                        end
                        q += 1
                    end
                    if !have is part = array_push(part, owned[o]) end
                    o += 1
                end
            elsif slug == "epic" is
                part = epic_list()
                let owned2: [model::Game] = epic_owned()
                let mut o2: int = 0
                while o2 < array_len(owned2) is
                    let mut have2: bool = false
                    let mut q2: int = 0
                    while q2 < array_len(part) is
                        if part[q2].id == owned2[o2].id is have2 = true end
                        q2 += 1
                    end
                    if !have2 is part = array_push(part, owned2[o2]) end
                    o2 += 1
                end
            elsif slug == "gog" is
                part = gog_list()
            elsif slug == "amazon" is
                let inst: [model::Game] = amazon_parse(shell("nile library list --installed --json 2>/dev/null"), true)
                part = inst
                let all_a: [model::Game] = amazon_parse(shell("nile library list --json 2>/dev/null"), false)
                let mut o3: int = 0
                while o3 < array_len(all_a) is
                    let mut have3: bool = false
                    let mut q3: int = 0
                    while q3 < array_len(part) is
                        if part[q3].id == all_a[o3].id is have3 = true end
                        q3 += 1
                    end
                    if !have3 is part = array_push(part, all_a[o3]) end
                    o3 += 1
                end
            elsif slug == "lutris" is
                part = lutris_list()
            elsif slug == "ea" is
                part = wine_dir_games("ea", ea_prefix(s) + "/drive_c/Program Files/EA Games", false, s)
            elsif slug == "battlenet" is
                part = wine_dir_games("battlenet", bnet_prefix(s) + "/drive_c/Program Files (x86)", true, s)
            elsif slug == "roblox" is
                part = roblox::list_games(false)
            end
            let mut k: int = 0
            while k < array_len(part) is
                all = array_push(all, part[k])
                k += 1
            end
        end
        p += 1
    end
    playtime::merge_into(all)
    return all
end

;; ── polecenia uruchomienia / instalacji / odinstalowania ─────────────────────
;; Zwracają linię powłoki albo "!komunikat błędu".

pub fn launch_command(s: settings::Settings, platform: string, id: string) -> string is
    if platform == "steam" is return steam_bin() + " -applaunch " + util::sq(id) end
    if platform == "epic" is return "legendary launch " + util::sq(id) end
    if platform == "gog" is
        let doc: string = util::read(gog_installed_path())
        let path: string = jsonlite::gstr(jsonlite::get(doc, id), "install_path")
        if path == "" is return "!GOG: gra nie jest zainstalowana" end
        return "gogdl --auth-config-path " + util::sq(gog_cfg()) + " launch " + util::sq(path) + " " + util::sq(id) + " --platform linux"
    end
    if platform == "amazon" is return "nile launch " + util::sq(id) end
    if platform == "lutris" is return "lutris lutris:rungame/" + util::sq(id) end
    if platform == "ea" is
        let pre: string = ea_prefix(s)
        if pre == "" is return "!EA app: nie znaleziono prefiksu Wine" end
        return "env WINEPREFIX=" + util::sq(pre) + " wine " + util::sq(ea_launcher_exe(pre))
    end
    if platform == "battlenet" is
        let pre2: string = bnet_prefix(s)
        if pre2 == "" is return "!Battle.net: nie znaleziono prefiksu Wine" end
        return "env WINEPREFIX=" + util::sq(pre2) + " wine " + util::sq(pre2 + "/drive_c/Program Files (x86)/Battle.net/Battle.net Launcher.exe")
    end
    if platform == "roblox" is
        return roblox::open_command(s, id, "")
    end
    return "!nieznana platforma: " + platform
end

pub fn install_command(s: settings::Settings, platform: string, id: string) -> string is
    if platform == "steam" is return steam_bin() + " steam://install/" + util::sq(id) end
    if platform == "epic" is return "legendary install " + util::sq(id) + " -y" end
    if platform == "gog" is
        util::mkdirp(gog_cfg())
        let dir: string = gog_default_root() + "/" + id
        util::mkdirp(dir)
        return "gogdl --auth-config-path " + util::sq(gog_cfg()) + " download " + util::sq(id) + " --platform linux --path=" + util::sq(dir) + " --lang=en --skip-dlcs"
    end
    if platform == "amazon" is return "nile install " + util::sq(id) end
    if platform == "lutris" is return "lutris lutris:" + util::sq(id) end
    if platform == "ea" || platform == "battlenet" is return launch_command(s, platform, id) end
    if platform == "roblox" is return roblox::install_client_command() end
    return "!nieznana platforma: " + platform
end

pub fn uninstall_command(s: settings::Settings, platform: string, id: string) -> string is
    if platform == "steam" is return steam_bin() + " steam://uninstall/" + util::sq(id) end
    if platform == "epic" is return "legendary uninstall " + util::sq(id) + " -y" end
    if platform == "gog" is
        let doc: string = util::read(gog_installed_path())
        let path: string = jsonlite::gstr(jsonlite::get(doc, id), "install_path")
        if path == "" || path == "/" is return "!GOG: brak ścieżki instalacji" end
        return "rm -rf -- " + util::sq(path)
    end
    if platform == "amazon" is return "nile uninstall " + util::sq(id) end
    if platform == "lutris" is
        return "!Lutris: odinstaluj grę w aplikacji Lutris (usuwanie plików wymaga potwierdzenia)"
    end
    if platform == "ea" is
        let pre: string = ea_prefix(s)
        if pre == "" || !safe_game_dir_name(id) is return "!EA app: nieprawidłowa gra" end
        return "rm -rf -- " + util::sq(pre + "/drive_c/Program Files/EA Games/" + id)
    end
    if platform == "battlenet" is
        let pre2: string = bnet_prefix(s)
        if pre2 == "" || !safe_game_dir_name(id) || bnet_non_game(id) is return "!Battle.net: nieprawidłowa gra" end
        return "rm -rf -- " + util::sq(pre2 + "/drive_c/Program Files (x86)/" + id)
    end
    if platform == "roblox" is
        roblox::unpin(id)
        return "true"
    end
    return "!nieznana platforma: " + platform
end

;; po udanej instalacji / odinstalowaniu (rejestr GOG)
pub fn on_install_finished(platform: string, id: string, title: string) is
    if platform == "gog" is gog_register_installed(id, title, gog_default_root() + "/" + id) end
end

pub fn on_uninstall_finished(platform: string, id: string) is
    if platform == "gog" is gog_unregister(id) end
end

;; polecenia klienta sklepu (przycisk "Otwórz klienta")
pub fn client_command(s: settings::Settings, platform: string) -> string is
    if platform == "steam" is return steam_bin() end
    if platform == "epic" || platform == "gog" is return "flatpak run com.heroicgameslauncher.hgl" end
    if platform == "lutris" is return "lutris" end
    if platform == "ea" is return launch_command(s, "ea", "") end
    if platform == "battlenet" is return launch_command(s, "battlenet", "") end
    return ""
end
