;; ═══ Steam ═══════════════════════════════════════════════════════════════════

fn steam_roots() -> [string] is
    let h: string = util::home()
    return [h + "/.steam/steam", h + "/.steam/root", h + "/.local/share/Steam",
            h + "/.var/app/com.valvesoftware.Steam/.local/share/Steam",
            h + "/.var/app/com.valvesoftware.Steam/.steam/steam"]
end

pub fn steam_root() -> string is
    let rs: [string] = steam_roots()
    let mut i: int = 0
    while i < array_len(rs) is
        if util::exists(rs[i] + "/steamapps") is return rs[i] end
        i += 1
    end
    return ""
end

fn steam_libraries(root: string) -> [string] is
    let mut libs: [string] = [root + "/steamapps"]
    let content: string = util::read(root + "/steamapps/libraryfolders.vdf")
    let paths: [string] = vdf::all(content, "path")
    let mut i: int = 0
    while i < array_len(paths) is
        let p: string = paths[i] + "/steamapps"
        if !util::has(libs, p) && util::exists(p) is libs = array_push(libs, p) end
        i += 1
    end
    return libs
end

fn steam_is_tool(name: string) -> bool is
    return string_starts_with(name, "Proton") || string_starts_with(name, "Steam Linux Runtime") ||
        string_starts_with(name, "Steamworks Common") || name == "Steam Controller Configs"
end

fn steam_cover(root: string, appid: string) -> string is
    let base: string = root + "/appcache/librarycache/" + appid
    let direct: [string] = [base + "/library_600x900.jpg", base + "/library_600x900.png"]
    let mut i: int = 0
    while i < array_len(direct) is
        if util::exists(direct[i]) is return direct[i] end
        i += 1
    end
    ;; nowszy układ: librarycache/<appid>/<hash>/library_600x900.jpg
    let found: string = util::sh("find " + util::sq(base) + " -maxdepth 2 -name 'library_600x900*' 2>/dev/null | head -n 1")
    return found
end

pub fn steam_list(s: settings::Settings) -> [model::Game] is
    let mut out: [model::Game] = []
    let root: string = steam_root()
    if root == "" is return out end
    let libs: [string] = steam_libraries(root)
    let mut li: int = 0
    while li < array_len(libs) is
        let files: [string] = util::ls(libs[li])
        let mut i: int = 0
        while i < array_len(files) is
            if string_starts_with(files[i], "appmanifest_") && string_ends_with(files[i], ".acf") is
                let c: string = util::read(libs[li] + "/" + files[i])
                let appid: string = vdf::first(c, "appid")
                let name: string = vdf::first(c, "name")
                if appid != "" && name != "" && !steam_is_tool(name) is
                    let mut g: model::Game = model::new_game("steam", appid, name)
                    g.installed = true
                    g.path = libs[li] + "/common/" + vdf::first(c, "installdir")
                    g.cover = steam_cover(root, appid)
                    out = array_push(out, g)
                end
            end
            i += 1
        end
        li += 1
    end
    return out
end

;; biblioteka posiadanych gier przez Steam Web API (klucz + SteamID64 w ustawieniach)
pub fn steam_owned(s: settings::Settings) -> [model::Game] is
    let mut out: [model::Game] = []
    let key: string = settings::get_str(s, "steam_api_key", "")
    let sid: string = settings::get_str(s, "steam_id64", "")
    if key == "" || sid == "" is return out end
    let url: string = "https://api.steampowered.com/IPlayerService/GetOwnedGames/v1/?key=" + key + "&steamid=" + sid + "&format=json&include_appinfo=true&include_played_free_games=true"
    let r: string = util::http_get(url, 20)
    let rows: [string] = jsonlite::items(jsonlite::path(r, "response.games"))
    let mut i: int = 0
    while i < array_len(rows) is
        let appid: string = jsonlite::unq(jsonlite::get(rows[i], "appid"))
        let name: string = jsonlite::gstr(rows[i], "name")
        if appid != "" && name != "" && !steam_is_tool(name) is
            let mut g: model::Game = model::new_game("steam", appid, name)
            g.playtime = jsonlite::gint(rows[i], "playtime_forever")
            g.cover = "https://cdn.cloudflare.steamstatic.com/steam/apps/" + appid + "/library_600x900.jpg"
            out = array_push(out, g)
        end
        i += 1
    end
    return out
end

fn steam_bin() -> string is
    if util::have("steam") is return "steam" end
    return "flatpak run com.valvesoftware.Steam"
end

;; appid gry uruchomionej teraz w lokalnym kliencie (registry.vdf → RunningAppID) albo ""
pub fn steam_running_appid() -> string is
    let h: string = util::home()
    let regs: [string] = [h + "/.steam/registry.vdf", h + "/.steam/steam/registry.vdf",
                          h + "/.var/app/com.valvesoftware.Steam/.steam/registry.vdf"]
    let mut i: int = 0
    while i < array_len(regs) is
        if util::exists(regs[i]) is
            let v: string = vdf::first(util::read(regs[i]), "RunningAppID")
            if v != "" && v != "0" is return v end
        end
        i += 1
    end
    return ""
end

