fn epic_logged_in() -> bool is
    if !util::have("legendary") is return false end
    let r: string = shell("legendary status --json 2>/dev/null")
    let acc: string = jsonlite::gstr(r, "account")
    return acc != "" && acc != "<not logged in>"
end

fn epic_list() -> [model::Game] is
    let mut out: [model::Game] = []
    if !util::have("legendary") is return out end
    let r: string = shell("legendary list-installed --json 2>/dev/null")
    let rows: [string] = jsonlite::items(r)
    let mut i: int = 0
    while i < array_len(rows) is
        if !jsonlite::gbool(rows[i], "is_dlc") is
            let id: string = jsonlite::gstr(rows[i], "app_name")
            let mut title: string = jsonlite::gstr(rows[i], "title")
            if title == "" is title = id end
            let mut g: model::Game = model::new_game("epic", id, title)
            g.installed = true
            g.path = jsonlite::gstr(rows[i], "install_path")
            out = array_push(out, g)
        end
        i += 1
    end
    return out
end

fn epic_owned() -> [model::Game] is
    let mut out: [model::Game] = []
    if !epic_logged_in() is return out end
    let r: string = shell("legendary list --json 2>/dev/null")
    let rows: [string] = jsonlite::items(r)
    let mut i: int = 0
    while i < array_len(rows) is
        if !jsonlite::gbool(rows[i], "is_dlc") is
            let id: string = jsonlite::gstr(rows[i], "app_name")
            let title: string = jsonlite::gstr(rows[i], "app_title")
            if id != "" && title != "" is out = array_push(out, model::new_game("epic", id, title)) end
        end
        i += 1
    end
    return out
end

;; ═══ GOG (gogdl) ════════════════════════════════════════════════════════════

fn gog_cfg() -> string is
    return util::config_dir() + "/hacker-mode/gog"
end

fn gog_installed_path() -> string is
    return gog_cfg() + "/installed.json"
end

fn gog_default_root() -> string is
    return util::home() + "/Games/HackerMode-GOG"
end

fn gog_logged_in() -> bool is
    return util::exists(gog_cfg() + "/auth.json")
end

fn gog_cover(id: string) -> string is
    let r: string = util::http_get("https://api.gog.com/products/" + id + "?expand=images", 8)
    let mut url: string = jsonlite::pstr(r, "images.logo2x")
    if url == "" is url = jsonlite::pstr(r, "images.background") end
    url = string_replace(url, "{" + "formatter}", "product_card_v2_mobile_slider_639")
    return covers::cache_image(url, "gog-" + id)
end

fn gog_list() -> [model::Game] is
    let mut out: [model::Game] = []
    let doc: string = util::read(gog_installed_path())
    let ks: [string] = jsonlite::keys(doc)
    let mut i: int = 0
    while i < array_len(ks) is
        let e: string = jsonlite::get(doc, ks[i])
        let mut g: model::Game = model::new_game("gog", ks[i], jsonlite::gstr(e, "title"))
        g.installed = true
        g.path = jsonlite::gstr(e, "install_path")
        let cached: string = covers::dir() + "/gog-" + ks[i] + ".jpg"
        if util::exists(cached) is g.cover = cached end
        out = array_push(out, g)
        i += 1
    end
    return out
end

pub fn gog_register_installed(id: string, title: string, path: string) is
    let doc: string = string_trim(util::read(gog_installed_path()))
    let base: string = if doc == "" then "{}" else doc
    let entry: string = "{\"title\":" + jsonlite::quote(title) + ",\"install_path\":" + jsonlite::quote(path) + "}"
    util::write_atomic(gog_installed_path(), jsonlite::pretty(jsonlite::set(base, id, entry), 0) + "\n", "")
end

pub fn gog_unregister(id: string) is
    let doc: string = string_trim(util::read(gog_installed_path()))
    if doc == "" is return end
    util::write_atomic(gog_installed_path(), jsonlite::pretty(jsonlite::del(doc, id), 0) + "\n", "")
end

