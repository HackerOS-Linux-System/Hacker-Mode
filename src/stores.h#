fn amazon_logged_in() -> bool is
    if !util::have("nile") is return false end
    return util::rc("nile library list") == 0
end

fn amazon_parse(r: string, installed: bool) -> [model::Game] is
    let mut out: [model::Game] = []
    let rows: [string] = jsonlite::items(r)
    let mut i: int = 0
    while i < array_len(rows) is
        let id: string = jsonlite::gstr(rows[i], "id")
        let mut title: string = jsonlite::gstr(rows[i], "product_title")
        if title == "" is title = jsonlite::gstr(rows[i], "title") end
        if id != "" && title != "" is
            let mut g: model::Game = model::new_game("amazon", id, title)
            g.installed = installed
            g.path = jsonlite::gstr(rows[i], "path")
            out = array_push(out, g)
        end
        i += 1
    end
    return out
end

;; ═══ Lutris ═════════════════════════════════════════════════════════════════

fn lutris_db() -> string is
    return util::data_dir() + "/lutris/pga.db"
end

fn lutris_cover(slug: string) -> string is
    let bases: [string] = [util::data_dir() + "/lutris", util::home() + "/.var/app/net.lutris.Lutris/data/lutris"]
    let exts: [string] = ["jpg", "png", "webp"]
    let mut b: int = 0
    while b < array_len(bases) is
        let mut e: int = 0
        while e < array_len(exts) is
            let p: string = bases[b] + "/coverart/" + slug + "." + exts[e]
            if util::exists(p) is return p end
            e += 1
        end
        b += 1
    end
    return ""
end

fn lutris_playtime(slug: string) -> int is
    if !util::have("sqlite3") || !util::exists(lutris_db()) is return -1 end
    let q: string = "SELECT playtime FROM games WHERE slug=" + "'" + string_replace(slug, "'", "''") + "'" + " AND playtime IS NOT NULL;"
    let v: string = util::sh("sqlite3 -noheader " + util::sq(lutris_db()) + " " + util::sq(q))
    if v == "" is return -1 end
    ;; Lutris trzyma godziny (liczba zmiennoprzecinkowa)
    let whole: int = str_to_int(util::before(v, "."))
    let frac: string = util::after(v, ".")
    let tenth: int = if frac == "" then 0 else str_to_int(string_slice(frac, 0, 1))
    return whole * 60 + (tenth * 6)
end

fn lutris_list() -> [model::Game] is
    let mut out: [model::Game] = []
    if !util::have("lutris") is return out end
    let r: string = shell("lutris -l --json 2>/dev/null")
    let rows: [string] = jsonlite::items(r)
    let mut i: int = 0
    while i < array_len(rows) is
        let slug: string = jsonlite::gstr(rows[i], "slug")
        let name: string = jsonlite::gstr(rows[i], "name")
        if slug != "" && name != "" is
            let mut g: model::Game = model::new_game("lutris", slug, name)
            g.installed = true
            g.path = jsonlite::gstr(rows[i], "directory")
            g.cover = lutris_cover(slug)
            g.playtime = lutris_playtime(slug)
            out = array_push(out, g)
        end
        i += 1
    end
    return out
end

;; ═══ EA app i Battle.net (Wine) ═════════════════════════════════════════════

fn ea_prefix(s: settings::Settings) -> string is
    let explicit: string = util::expand(settings::get_str(s, "ea_wine_prefix", ""))
    let mut cands: [string] = []
    if explicit != "" is cands = array_push(cands, explicit) end
    let h: string = util::home()
    cands = array_push(cands, h + "/Games/ea-app")
    cands = array_push(cands, h + "/Games/ea")
    cands = array_push(cands, h + "/Games/EA App")
    let mut i: int = 0
    while i < array_len(cands) is
        let base: string = cands[i] + "/drive_c/Program Files/Electronic Arts/EA Desktop/EA Desktop/"
        if util::exists(base + "EALauncher.exe") || util::exists(base + "EADesktop.exe") is return cands[i] end
        i += 1
    end
    return ""
end

fn ea_launcher_exe(prefix: string) -> string is
    let base: string = prefix + "/drive_c/Program Files/Electronic Arts/EA Desktop/EA Desktop/"
    if util::exists(base + "EALauncher.exe") is return base + "EALauncher.exe" end
    return base + "EADesktop.exe"
end

pub fn bnet_prefix(s: settings::Settings) -> string is
    let explicit: string = util::expand(settings::get_str(s, "battlenet_wine_prefix", ""))
    let mut cands: [string] = []
    if explicit != "" is cands = array_push(cands, explicit) end
    let h: string = util::home()
    cands = array_push(cands, h + "/Games/battlenet")
    cands = array_push(cands, h + "/Games/battle-net")
    cands = array_push(cands, h + "/Games/Battle.net")
    let mut i: int = 0
    while i < array_len(cands) is
        if util::exists(cands[i] + "/drive_c/Program Files (x86)/Battle.net/Battle.net Launcher.exe") is return cands[i] end
        i += 1
    end
    return ""
end

fn bnet_non_game(name: string) -> bool is
    let n: string = string_lower(name)
    let skip: [string] = ["battle.net", "common files", "installshield installation information", "internet explorer",
        "windows nt", "windows mail", "windows media player", "windows photo viewer", "windowspowershell"]
    return util::has(skip, n)
end

fn wine_dir_games(platform: string, dir: string, filter_bnet: bool, s: settings::Settings) -> [model::Game] is
    let mut out: [model::Game] = []
    let names: [string] = util::ls(dir)
    let sorted: [string] = sort_strings(names)
    let key: string = settings::get_str(s, "steamgriddb_api_key", "")
    let mut i: int = 0
    while i < array_len(sorted) is
        let n: string = sorted[i]
        if fs_is_dir(dir + "/" + n) && !(filter_bnet && bnet_non_game(n)) is
            let mut g: model::Game = model::new_game(platform, n, n)
            g.installed = true
            g.path = dir + "/" + n
            if key != "" is g.cover = covers::steamgriddb_cover(n, platform + "-" + n, key) end
            out = array_push(out, g)
        end
        i += 1
    end
    return out
end

fn safe_game_dir_name(id: string) -> bool is
    return id != "" && !string_contains(id, "/") && !string_contains(id, "\\") && !string_contains(id, "..")
end

;; ═══ Dostępność, lista, polecenia ═══════════════════════════════════════════

pub fn is_available(s: settings::Settings, platform: string) -> bool is
    if platform == "steam" is return steam_root() != "" end
    if platform == "epic" is return util::have("legendary") end
    if platform == "gog" is return util::have("gogdl") end
    if platform == "amazon" is return util::have("nile") end
    if platform == "lutris" is return util::have("lutris") end
    if platform == "ea" is return util::have("wine") && ea_prefix(s) != "" end
    if platform == "battlenet" is return util::have("wine") && bnet_prefix(s) != "" end
    if platform == "roblox" is return true end
    return false
end

pub fn is_logged_in(s: settings::Settings, platform: string) -> bool is
    if platform == "steam" is return steam_root() != "" end
    if platform == "epic" is return epic_logged_in() end
    if platform == "gog" is return gog_logged_in() end
    if platform == "amazon" is return amazon_logged_in() end
    return true
end

pub fn supports_login(platform: string) -> bool is
    return platform == "epic" || platform == "gog" || platform == "amazon"
end

