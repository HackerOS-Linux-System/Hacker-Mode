pub fn sober_id() -> string is return "org.vinegarhq.Sober" end

pub struct Info is
    pub place:    string
    pub universe: string
    pub name:     string
    pub creator:  string
    pub genre:    string
    pub desc:     string
    pub playing:  int
    pub visits:   int
    pub favs:     int
    pub likes:    int      ;; % pozytywnych ocen, -1 = brak
    pub icon:     string   ;; lokalna ścieżka ikony ("" = brak)
end

pub fn empty_info() -> Info is
    return Info { place: "", universe: "", name: "", creator: "", genre: "", desc: "", playing: 0, visits: 0, favs: 0, likes: -1, icon: "" }
end

;; ── wykrywanie klienta ───────────────────────────────────────────────────────

pub fn flatpak_available() -> bool is
    return util::have("flatpak")
end

pub fn sober_installed() -> bool is
    if !flatpak_available() is return false end
    return util::rc("flatpak info " + sober_id()) == 0
end

pub fn arch_ok() -> bool is
    return util::sh("uname -m") == "x86_64"
end

;; czy schemat roblox:// ma przypisaną aplikację
pub fn handler_registered() -> bool is
    return util::sh("xdg-mime query default x-scheme-handler/roblox 2>/dev/null") != ""
end

pub fn vulkan_ok() -> bool is
    if util::have("vulkaninfo") is return util::rc("vulkaninfo --summary") == 0 end
    return util::rc("ls /usr/share/vulkan/icd.d /etc/vulkan/icd.d") == 0
end

;; Sober działa teraz?
pub fn running() -> bool is
    if !flatpak_available() is return false end
    let out: string = shell("flatpak ps --columns=application 2>/dev/null")
    return string_contains(out, sober_id())
end

;; ── polecenia ────────────────────────────────────────────────────────────────

pub fn launch_uri(place: string, link_code: string) -> string is
    let mut u: string = "roblox://experiences/start?placeId=" + place
    if link_code != "" is u = u + "&linkCode=" + link_code end
    return u
end

;; Polecenie otwierające URI. `roblox_command` w config.json może je nadpisać ({uri}, {place}).
pub fn open_command(s: settings::Settings, place: string, link_code: string) -> string is
    let uri: string = launch_uri(place, link_code)
    let custom: string = settings::get_str(s, "roblox_command", "")
    if custom != "" is
        return string_replace(string_replace(custom, "{uri}", util::sq(uri)), "{place}", place)
    end
    if sober_installed() is
        ;; ta sama linia co w oficjalnym wpisie .desktop Sobera (MimeType=x-scheme-handler/roblox)
        return "flatpak run --command=sober --file-forwarding " + sober_id() + " --@@u " + util::sq(uri) + " @@"
    end
    return "xdg-open " + util::sq(uri)
end

pub fn stop_command() -> string is
    return "flatpak kill " + sober_id()
end

pub fn install_client_command() -> string is
    return "flatpak install -y --noninteractive flathub " + sober_id()
end

pub fn uninstall_client_command() -> string is
    return "flatpak uninstall -y --noninteractive " + sober_id()
end

