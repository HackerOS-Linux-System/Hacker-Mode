mod util

pub struct View is
    pub out:   string
    pub depth: int
end

pub fn view() -> View is
    return View { out: "", depth: 0 }
end

;; kodowanie pól: % → %25, tab → %09, nowa linia → %0A
pub fn enc(s: string) -> string is
    let a: string = string_replace(s, "%", "%25")
    let b: string = string_replace(a, "\t", "%09")
    return string_replace(b, "\n", "%0A")
end

pub fn dec(s: string) -> string is
    let a: string = string_replace(s, "%09", "\t")
    let b: string = string_replace(a, "%0A", "\n")
    return string_replace(b, "%25", "%")
end

;; atrybut `k=v` (poprzedzony tabulatorem)
pub fn a(k: string, v: string) -> string is
    return "\t" + k + "=" + enc(v)
end

fn emit(v: View, kind: string, arg: string, attrs: string) is
    v.out = v.out + to_string(v.depth) + "\t" + kind + "\t" + enc(arg) + attrs + "\n"
end

;; element z dziećmi: po `open` wołaj `close`
pub fn open(v: View, kind: string, arg: string, attrs: string) is
    emit(v, kind, arg, attrs)
    v.depth += 1
end

pub fn close(v: View) is
    v.depth -= 1
end

pub fn leaf(v: View, kind: string, arg: string, attrs: string) is
    emit(v, kind, arg, attrs)
end

;; ── skróty ───────────────────────────────────────────────────────────────────

pub fn gap(v: View, px: int) is
    emit(v, "space", "", a("w", "px:" + to_string(px)) + a("h", to_string(px)))
end

pub fn grow(v: View) is
    emit(v, "space", "", a("w", "fill"))
end

pub fn label(v: View, s: string, cls: string) is
    emit(v, "text", s, a("class", cls))
end

pub fn title(v: View, s: string, size: int) is
    emit(v, "text", s, a("size", to_string(size)) + a("bold", "1"))
end

;; przycisk tekstowy; id → zdarzenie, class: primary | danger | success | ghost
pub fn btn(v: View, text: string, id: string, cls: string, icon: string) is
    let mut at: string = a("press", id) + a("class", cls)
    if icon != "" is at = at + a("icon", icon) end
    emit(v, "button", text, at)
end

pub fn btn_off(v: View, text: string, cls: string, icon: string) is
    let mut at: string = a("class", cls) + a("disabled", "1")
    if icon != "" is at = at + a("icon", icon) end
    emit(v, "button", text, at)
end

;; chip filtrów
pub fn chip(v: View, text: string, id: string, active: bool) is
    emit(v, "button", text, a("press", id) + a("class", if active then "chip chip-on" else "chip"))
end

