pub fn open_client(s: settings::Settings, platform: string) -> jobs::Job is
    let cmd: string = stores::client_command(s, platform)
    if cmd == "" is
        let mut bad: jobs::Job = jobs::start("client", platform, "", model::label(platform), "false", "")
        bad.pid = -1
        bad.done = true
        bad.last_line = "Ta platforma nie ma osobnego klienta."
        return bad
    end
    return jobs::start("client", platform, "", model::label(platform), cmd, "")
end

;; Zamknięcie zadania gry: czas gry, wyjście z trybu wrapper, powiadomienie. Zwraca komunikat statusu.
pub fn finish_game(s: settings::Settings, j: jobs::Job, dev: bool) -> string is
    let mins: int = jobs::minutes_ran(j)
    if mins >= 1 is playtime::add_minutes(j.platform, j.game_id, mins) end
    if settings::wrapper_mode(s) && !dev is compositor::exit_wrapper(s) end
    let threshold: int = settings::get_int(s, "crash_detection_threshold_seconds", 8)
    let elapsed: int = now_unix() - j.started
    if !j.ok && elapsed < threshold && j.watch == "" is
        return "„" + j.title + "” zakończyła się natychmiast — możliwy błąd uruchomienia."
    end
    return "„" + j.title + "” zakończona (" + util::fmt_minutes(mins) + ")."
end
