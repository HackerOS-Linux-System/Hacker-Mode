;; rysuje `view`, zwraca zdarzenia jako linie „id TAB tekst” (pierwsze: te zebrane wcześniej)
pub fn frame(w: Win, view: string) -> [string] is
    let ms = App_frame1(w.app, build(view))
    let mut out: [string] = w.pending
    w.pending = []
    let n: int = List_Message_len(ms)
    let mut i: int = 0
    while i < n is
        let m = List_Message_get(ms, i)
        let id: string = Message_get_id(m)
        if id != "" && id != "focus" && id != "tick" is
            out = array_push(out, id + "\t" + Message_get_text(m))
        end
        i += 1
    end
    return out
end

;; rysowanie w trakcie operacji blokującej (np. „Szukam…”): zdarzenia odkładamy na później
pub fn draw_now(w: Win, view: string) is
    let ev: [string] = frame(w, view)
    w.pending = ev
end
